# Просто пример настройки помещнный в гит, убери .example и он не будет виден гиту

# Куда класть готовый билд
BUILD_OUTPUT_DIR=C:\Games\NeuroMita\NeuroMitaBuild5

# Режим: fast (только .pyz + requirements.txt + fast-папки) или full (.pyz + копирование файлов)
BUILD_MODE=fast

# Папки для full-режима (через запятую).
# Относительный путь — от папки проекта, абсолютный — берётся как есть.
# Имя папки в билде всегда = последний компонент пути.
# Пример с абсолютным путём для libs без кеша:
#   BUILD_COPY_DIRS=extra\Prompts,C:\Games\NeuroMita\libs
BUILD_COPY_DIRS=Prompts,scripts,assets,libs

# Папки для fast-режима (по умолчанию только Prompts)
BUILD_FAST_COPY_DIRS=extra\Prompts

# Исключать dot-папки (.cache, .git и т.п.) при копировании папок
# 1 — включено (по умолчанию), 0 — выключено
BUILD_EXCLUDE_DOT_DIRS=1

# Исключать папки checkpoints при копировании (модели, тяжёлые файлы)
# 1 — включено (по умолчанию), 0 — выключено
BUILD_EXCLUDE_CHECKPOINTS=1

# Файлы для копирования (через запятую, относительно PROJECT_DIR или абсолютный путь)
# Каждый копируется в корень BUILD_OUTPUT_DIR
BUILD_COPY_FILES=extra/init.py,extra/Icon.png

# Скрипты запуска/установки — копируются в корень билда всегда (в обоих режимах)
# Через запятую, относительно PROJECT_DIR или абсолютный путь
BUILD_ROOT_SCRIPTS=scripts\run.bat,scripts\install_nvidia.cmd

# Упаковать итоговый билд в zip-архив
# 1 — включено, 0 — выключено (по умолчанию)
BUILD_ARCHIVE=1
# Путь к итоговому архиву (включая имя файла, .zip добавлять не нужно)
BUILD_ARCHIVE_PATH=C:\Games\NeuroMita\NeuroMitaCurrentBuild
