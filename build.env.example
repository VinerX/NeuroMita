# Просто пример настройки помещнный в гит, убери .example и он не будет виден гиту

# Локальный конфиг сборки — в .gitignore, настраивается под каждый ПК

# Куда класть готовый билд
BUILD_OUTPUT_DIR=C:\Games\NeuroMita\NeuroMitaBuild2

# Режим: fast (только .pyz) или full (.pyz + копирование файлов)
BUILD_MODE=full

# Папки для копирования (через запятую, относительно PROJECT_DIR)
# Каждая будет скопирована в BUILD_OUTPUT_DIR с тем же именем
BUILD_COPY_DIRS=Prompts,scripts,assets,libs

# Файлы для копирования (через запятую, относительно PROJECT_DIR)
# Каждый будет скопирован в корень BUILD_OUTPUT_DIR
BUILD_COPY_FILES=extra/init.py,extra/Icon.png

# Скрипты запуска/установки (run.bat, install.bat и т.п.) — копируются в корень всегда
# Через запятую, относительно PROJECT_DIR
#BUILD_ROOT_SCRIPTS=run.bat,install.bat
