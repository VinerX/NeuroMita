// ===== ЧИСТКА ТЕКСТА =====
RULE RemoveAsterisks
    MATCH REGEX "(\*{1,3})"
    ACTIONS
        REMOVE_MATCH
    END_ACTIONS
END_RULE

DEBUG_DISPLAY
    "Attitude": attitude
    "Boredom": boredom
    "Stress": stress
    "Message time": SYSTEM_DATETIME
END_DEBUG_DISPLAY
