// ===== АКТИВАЦИЯ ИСПЫТАНИЙ (Structured Output) =====
// Requires config.json: custom_params[{name: "secret_trial", type: "bool"}]
RULE SecretQuestActivation
    MATCH FIELD "secret_trial"
    ACTIONS
        SET secretTrial = secret_trial
        LOG "secretTrial set to " + str(secret_trial)
    END_ACTIONS
END_RULE

