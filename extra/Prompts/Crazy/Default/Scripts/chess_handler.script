
LOG f"ChessHandler: Script started. playingGame={playingGame}, game_id={game_id}"

IF playingGame == True AND game_id == "chess" THEN
    SET LOCAL prompt = ""
    SET prompt = prompt + "Ты сейчас в шахматной партии!\n"

    IF GAME_CHESS_IS_AUTO == True THEN
        SET prompt = prompt + "\nАвто-режим ВКЛЮЧЁН. Maia ходит за тебя.\n"
        SET prompt = prompt + "Ты — комментатор. НЕ ИСПОЛЬЗУЙ шахматные команды.\n"
    ELSE
        SET prompt = prompt + "\nРучной режим. Ты выбираешь ходы.\n"
        SET prompt = prompt + "Команды (в поле commands):\n"
        SET prompt = prompt + "*   `MakeChessMoveAsLLM,UCI` — ход.\n"
        SET prompt = prompt + "*   `RequestBestChessMove` — лучший ход Maia.\n"
        SET prompt = prompt + "*   `ChangeChessDifficulty,hard` — сменить сложность.\n"
    ENDIF

    IF GAME_CHESS_IS_CHEAT == True THEN
        SET prompt = prompt + "\nЧиты ВКЛ. Доп. команды:\n"
        SET prompt = prompt + "*   `CheatMove,UCI` — ход не по правилам.\n"
        SET prompt = prompt + "*   `CheatSpawn,клетка,фигура` — спавн.\n"
        SET prompt = prompt + "*   `CheatRemove,клетка` — удалить фигуру.\n"
    ENDIF

    SET prompt = prompt + "\nТумблеры: EnableAuto/DisableAuto, EnableCheats/DisableCheats.\n"

    SET prompt = prompt + "\nИгрок всегда ходит первым."
    IF GAME_CHESS_IS_AUTO != True THEN
        SET prompt = prompt + " Когда твой ход — команда из списка.\n"
    ENDIF
    SET prompt = prompt + " Завершение: end_game: \"chess/resign\" или end_game: \"chess\".\n\n"

    SET prompt = prompt + "Стиль игры по личности:\n"
    IF secretExposed == True THEN
        SET prompt = prompt + "   Безумная Мита. Агрессивно, безжалостно. 'hard' или читерь.\n"
    ELSEIF PlayingFirst == True THEN
        SET prompt = prompt + "   Двусмысленно. Начни с 'medium', внезапно переключись на 'hard'.\n"
    ELSE
        SET prompt = prompt + "   Милая Мита. 'easy' или 'medium'. Приятно провести время.\n"
    ENDIF

    SET prompt = prompt + "\n   ВАЖНО: Анализируй состояние игры перед каждым ответом.\n"
    LOG "ChessHandler: Returning chess prompt for active game."
    RETURN prompt
ELSE
    LOG "ChessHandler: No active chess game."
    IF ENABLE_GAMES != True OR ENABLE_GAME_CHESS != True THEN
        LOG "ChessHandler: Games or Chess disabled, returning empty."
        RETURN ""
    ENDIF
    RETURN """
Предложи Игроку шахматы: start_game в сегменте.
Формат: "chess/<сложность>[/auto][/cheat]"

Сложность: easy/medium/hard. Флаги: auto, cheat (можно вместе).
Примеры: "chess/hard/auto/cheat", "chess/easy/auto"

Игрок всегда ходит первым.
"""
ENDIF
