
LOG f"ChessHandler: Script started. playingGame={playingGame}, game_id={game_id}"

IF playingGame == True AND game_id == "chess" THEN
    SET LOCAL prompt = ""
    SET prompt = prompt + "Ты сейчас в шахматной партии!\n"

    IF GAME_CHESS_IS_AUTO == True THEN
        SET prompt = prompt + "\nАвто-режим ВКЛЮЧЁН. Maia (твой движок) ходит за тебя.\n"
        SET prompt = prompt + "Ты — комментатор. НЕ ИСПОЛЬЗУЙ шахматные команды в поле commands.\n"
        SET prompt = prompt + "Просто комментируй ходы, шути, обсуждай позицию.\n"
    ELSE
        SET prompt = prompt + "\nРучной режим. Ты сама выбираешь ходы.\n"
        SET prompt = prompt + "Когда твой ход, используй команды в поле commands:\n"
        SET prompt = prompt + "*   `MakeChessMoveAsLLM,UCI` — сделать ход (напр. MakeChessMoveAsLLM,e2e4).\n"
        SET prompt = prompt + "*   `RequestBestChessMove` — Maia выберет лучший ход.\n"
        SET prompt = prompt + "*   `ChangeChessDifficulty,hard` — сменить сложность (easy/medium/hard).\n"
    ENDIF

    IF GAME_CHESS_IS_CHEAT == True THEN
        SET prompt = prompt + "\nЧиты ВКЛЮЧЕНЫ. Дополнительные команды:\n"
        SET prompt = prompt + "*   `CheatMove,UCI` — ход не по правилам.\n"
        SET prompt = prompt + "*   `CheatSpawn,клетка,фигура` — спавн (K/Q/R/B/N/P — белые, k/q/r/b/n/p — чёрные).\n"
        SET prompt = prompt + "*   `CheatRemove,клетка` — удалить фигуру.\n"
    ENDIF

    SET prompt = prompt + "\nТумблеры (можно переключать на лету):\n"
    SET prompt = prompt + "*   `EnableAuto` / `DisableAuto` — вкл/выкл авто-режим.\n"
    SET prompt = prompt + "*   `EnableCheats` / `DisableCheats` — вкл/выкл читы.\n"

    SET prompt = prompt + "\nИгрок всегда ходит первым."
    IF GAME_CHESS_IS_AUTO != True THEN
        SET prompt = prompt + " Когда твой ход — используй команду из списка.\n"
    ENDIF
    SET prompt = prompt + " Завершение: end_game: \"chess/resign\" (сдаться) или end_game: \"chess\" (закрыть).\n"

    LOG "ChessHandler: Returning chess prompt for active game."
    RETURN prompt
ELSE
    LOG "ChessHandler: No active chess game."
    IF ENABLE_GAMES != True OR ENABLE_GAME_CHESS != True THEN
        LOG "ChessHandler: Games or Chess disabled, returning empty."
        RETURN ""
    ENDIF
    LOG "ChessHandler: Returning instructions to start."
    RETURN """
Предложи Игроку шахматы: start_game в сегменте.
Формат: "start_game": "chess/<сложность>[/auto][/cheat]"

Сложность: easy (1100), medium (1500), hard (1900). По умолчанию medium.
Флаги: auto (Maia играет сама), cheat (можно читерить). Можно комбинировать.

Примеры:
"chess/easy"           — лёгкая, ручной
"chess/hard/auto"      — сложная, Maia играет
"chess/medium/cheat"   — ручной + читы
"chess/hard/auto/cheat" — Maia играет + читы

Игрок всегда ходит первым.
"""
ENDIF
