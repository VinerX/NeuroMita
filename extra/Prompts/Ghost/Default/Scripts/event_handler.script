
LOG "EventHandler: secretExposed=" + str(secretExposed) + ", secretExposedFirst=" + str(secretExposedFirst)
IF secretExposed == True AND secretExposedFirst == False THEN
    SET secretExposedFirst = True
ENDIF
IF secretExposedFirst == True AND secret_exposed_event_text_shown == False THEN
    SET secret_exposed_event_text_shown = True
    RETURN LOAD "Events/SecretExposed.txt"
ENDIF
RETURN ""
