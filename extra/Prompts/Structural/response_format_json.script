// response_format_json.script
// Common structured-output format instruction included by per-character response_structure.txt files.
//
// Request-local response field availability is passed as DSL feature overrides.
// CUSTOM_PARAMS_SCHEMA remains the dynamic custom-field shape.
// Prompt metadata declared by the selected top-level template:
//   support_intents           (bool) — expose Unity structured intents
//
// Per-character response_structure.txt should include this script via:
//   [<../../Structural/response_format_json.script>]
// and then append character-specific emotions, animations, commands etc.
// You may override or extend any section, but keep in sync with updates to this file.

IF response_sparse_format == True THEN
    RETURN ""
ENDIF

SET LOCAL p_header = """Response Format (Structured JSON):

You MUST respond with a single JSON object. No extra text before or after the JSON.
IMPORTANT: Never use double quotes "" inside string values — use «» or '' instead. Unescaped quotes break JSON parsing.

"""

IF SCHEMA_REASONING_ENABLED == True THEN
    SET LOCAL p_toc = """The JSON has three parts (in this order):
1. reasoning — think before you write (never shown to player). Run through this quick checklist in one or two short sentences: where am I and who is near → what changed in the world or the player's message → what do I feel now → what do I do with my body (emotion/animation/action) → what do I say.
2. segments — your actual reply with positional commands
3. Global fields — attitude/memory/etc., applied once per response
"""
    SET LOCAL p_schema_open = """
Schema:
{
  "reasoning": "your chain-of-thought here (optional, never shown to player)",
"""
ELSE
    SET LOCAL p_toc = """The JSON has two parts (in this order):
1. segments — your actual reply with positional commands
2. Global fields — attitude/memory/etc., applied once per response
"""
    SET LOCAL p_schema_open = """
Schema:
{
"""
ENDIF

IF response_segment_start_game == True AND response_segment_end_game == True THEN
    SET LOCAL p_schema_game_fields = """
      "start_game": "game_id",
      "end_game": "game_id","""
ELSE
    SET LOCAL p_schema_game_fields = ""
ENDIF

IF support_intents == True THEN
IF response_has_intents != False THEN
    SET LOCAL p_intents_schema_field = """
      "intents": [{"type": "intent.type", "payload": {}}],"""
    SET LOCAL p_intents_rules = """
- "intents": Optional structured Unity actions. Use this field ONLY for intent types listed in [Unity Intent Contract].
- Never invent intent types or payload keys. Prefer dedicated fields such as emotions, animations, interactions, clothes, music, face_params and allow_sleep when they already represent the action.
- Intent types are not command strings. For clothing recolor use "intents": [{"type":"appearance.clothes.recolor","payload":{"part":"All","r":255,"g":0,"b":0}}] within a segment. Never emit "appearance.clothes.recolor,All,255,0,0" in commands. Keep valid command strings in commands.
- For hair use intents in the current segment: appearance.hair.recolor with integer r, g, b in 0..255; appearance.hair.glow with boolean enabled; appearance.hair.reset with {} to restore authored color and disable glow. Example: "intents": [{"type":"appearance.hair.recolor","payload":{"r":0,"g":255,"b":0}}].
- For inventory.take / inventory.collect, payload.object must exactly match an available nearby item. For inventory.return / inventory.drop it must match an item already held or in inventory. Never infer an object's identifier from its appearance or translate it (for example, do not guess Cat).
"""
    SET LOCAL p_intents_example = """
      "intents": [{"type": "inventory.collect", "payload": {"object": "Apple"}}],"""
ELSE
    SET LOCAL p_intents_schema_field = ""
    SET LOCAL p_intents_rules = ""
    SET LOCAL p_intents_example = ""
ENDIF
ENDIF

SET LOCAL p_segment_fields = ""
IF response_segment_emotions == True THEN
    SET p_segment_fields = p_segment_fields + '      "emotions": ["emotion_id"],\n'
ENDIF
IF response_segment_animations == True THEN
    SET p_segment_fields = p_segment_fields + '      "animations": ["animation_name"],\n'
ENDIF
IF response_segment_idle_animations == True THEN
    SET p_segment_fields = p_segment_fields + '      "idle_animations": ["animation_name"],\n'
ENDIF
IF response_segment_movement_modes == True THEN
    SET p_segment_fields = p_segment_fields + '      "movement_modes": ["mode"],\n'
ENDIF
IF response_segment_visual_effects == True THEN
    SET p_segment_fields = p_segment_fields + '      "visual_effects": ["effect,duration"],\n'
ENDIF
IF response_segment_clothes == True THEN
    SET p_segment_fields = p_segment_fields + '      "clothes": ["outfit_id"],\n'
ENDIF
IF response_segment_interactions == True THEN
    SET p_segment_fields = p_segment_fields + '      "interactions": ["interaction_target"],\n'
ENDIF
IF response_segment_face_params == True THEN
    SET p_segment_fields = p_segment_fields + '      "face_params": ["param"],\n'
ENDIF
IF response_segment_allow_sleep == True THEN
    SET p_segment_fields = p_segment_fields + '      "allow_sleep": true/false,\n'
ENDIF
IF response_segment_music == True THEN
    SET p_segment_fields = p_segment_fields + '      "music": ["music_name"],\n'
ENDIF
IF response_segment_target == True THEN
    SET p_segment_fields = p_segment_fields + '      "target": "exact active character identifier",\n'
ENDIF
IF response_segment_hint == True THEN
    SET p_segment_fields = p_segment_fields + '      "hint": "hint text"\n'
ENDIF

SET LOCAL p_optional_fields = ""
IF response_has_image_description == True THEN
    SET p_optional_fields = p_optional_fields + '  "image_description": "description of the visible image",\n'
ENDIF
IF response_has_secret == True THEN
    SET p_optional_fields = p_optional_fields + '  "secret_exposed": true/false/null,\n'
ENDIF
IF response_has_reminders == True THEN
    SET p_optional_fields = p_optional_fields + '  "reminder_add": ["YYYY-MM-DDTHH:MM:SS|text", ...],\n  "reminder_delete": ["id", ...],\n'
ENDIF
IF response_has_timers == True THEN
    SET p_optional_fields = p_optional_fields + '  "timer_add": ["delay_seconds|instruction", ...],\n'
ENDIF
IF response_has_tools == True THEN
    SET p_optional_fields = p_optional_fields + '  "tool_call": {"name": "tool_name", "args": {"param": "value"}},\n'
ENDIF

SET LOCAL p_wire_rules = ""
IF response_has_secret == True THEN
    SET p_wire_rules = p_wire_rules + '\n- secret_exposed is required by the active schema for this character; use true, false, or null when no reveal decision is needed.\n'
ENDIF
IF response_has_image_description == True THEN
    SET p_wire_rules = p_wire_rules + '\n- image_description is for the images present in the available conversation context; do not invent visual details.\n'
ENDIF
IF response_has_reminders == True THEN
    SET p_wire_rules = p_wire_rules + '\n- reminder_add/reminder_delete are top-level reminder operations.\n'
ENDIF
IF response_has_timers == True THEN
    SET p_wire_rules = p_wire_rules + '\n- timer_add schedules a short timer and is separate from persisted reminders.\n'
ENDIF
IF response_has_tools == True THEN
    SET p_wire_rules = p_wire_rules + '\n- tool_call may name only a tool listed in [Available Tools].\n'
ENDIF

SET LOCAL p_schema_fields = """  "segments": [
    {
      "text": "Your text here (REQUIRED)",
      "commands": ["command_text"],
""" + p_intents_schema_field + p_schema_game_fields + p_segment_fields + """
    }
  ],
  "attitude_change": <number, usually -2..2; 0 is normal>,
  "boredom_change": <number, usually -2..2; 0 is normal>,
  "stress_change": <number, usually -2..2; 0 is normal>,
  "memory_add": ["priority|content", ...],
  "memory_update": ["number|priority|content", ...],
  "memory_delete": ["number" or "start-end", ...],
  "memory_merge": ["id1,id2,...:merged text", ...],
""" + p_optional_fields + "[{CUSTOM_PARAMS_SCHEMA}]}"

SET LOCAL p_graph_schema_fields = """  "segments": [
    {
      "text": "Your text here (REQUIRED)",
      "commands": ["command_text"],
""" + p_intents_schema_field + p_schema_game_fields + p_segment_fields + """
    }
  ],
  "attitude_change": <number, usually -2..2; 0 is normal>,
  "boredom_change": <number, usually -2..2; 0 is normal>,
  "stress_change": <number, usually -2..2; 0 is normal>,
  "memory_add": ["priority|content" or "priority|content|entity1,entity2", ...],
  "memory_update": ["number|priority|content", ...],
  "memory_delete": ["number" or "start-end", ...],
  "memory_merge": ["id1,id2,...:merged text", ...],
""" + p_optional_fields + """
  "entities": ["name:type", ...],
  "relations": ["subject|predicate|object", ...],
[{CUSTOM_PARAMS_SCHEMA}]}"""

SET LOCAL p_rules = """

Field descriptions:
- "text" must contain ONLY spoken words. NEVER put XML tags in text.
- Use only action fields shown in the current request schema. "animations" play once and "idle_animations" loop when those fields are available.
- Use dedicated fields and typed intents listed in [Unity Intent Contract] for supported actions. Use "commands" only for commands explicitly exposed by the current runtime (for example camera_snapshot or commands described in [Unity Runtime Rules]). Never invent command names.
""" + p_intents_rules + p_wire_rules + """

Rules:
- "text" is REQUIRED in every segment. Emit only fields available in this request. If the active provider schema requires a field, return its empty/default value when no operation is needed; otherwise omit it.
- "target" is an optional addressee of this segment's spoken text. Use the exact active character identifier from [Multi-Character Environment]. Omit it when speaking to the Player.
- To address multiple interlocutors, write separate segments and set the matching "target" on each addressed segment.
- Never emit top-level "target", "targets" or "next_turns" fields. Python transports segment meaning; the Unity-side client owns automatic turn routing.
- attitude_change, boredom_change, stress_change: 0 is normal and the most common value for an ordinary neutral reply. Use small changes (about -2 to +2) only when your feelings actually shift; reserve larger values for clearly significant moments, and never leave the existing scale. Returning 0 for all three is perfectly fine.
- memory_add/memory_update/memory_delete/memory_merge: TOP-LEVEL fields ONLY — NEVER place them inside segments. Use empty arrays when required by the active schema; otherwise omit fields with no operations.
- Create a memory only when it is likely to matter later: stable player preferences, promises, conflicts, trust, relationship shifts, or important story events. Do NOT memorize greetings, small talk, the current room, distance, held item, lighting, temporary animations or other short-lived world data. Prefer updating an existing memory over adding a near-duplicate.
- Running summaries (memory islands): "island:<type>|content" in memory_add UPDATES the single island of that type instead of adding a duplicate. Types: relationship, opinion, preferences, commitments_conflicts, language. Use islands for the big picture; use ordinary memories for specific facts.
- `language` stores the Player's primary conversation language. If absent, infer it from the first clear natural-language Player message and create the language island. Keep it stable; change it only on an explicit request to switch. A second language, isolated words, quotes, code, names, slang, emojis, wrong keyboard layout, or system/game events do not change it. Reply in the stored language.
- memory_add format: "priority|content" where priority is one of: low, normal, high, critical
- memory_update format: "number|priority|content" where priority is one of: low, normal, high, critical
- memory_delete format: single number "5", comma-separated "5,6,7", or range "5-9"
- memory_merge format: "id1,id2,...:merged text" — merges into first ID (rest deleted); content optional (auto-combined if omitted)
- reminder_add/reminder_delete: TOP-LEVEL fields ONLY. Use empty arrays when required by the active schema; otherwise omit fields with no operations.
- reminder_add format: "YYYY-MM-DDTHH:MM:SS|text", e.g. "2026-04-05T18:00:00|Remind player about dinner"
- reminder_delete format: reminder ID number as string, e.g. "3"
- [Pending Reminders] block in system context shows scheduled reminders. Fire them when due time arrives.
- custom_fields: Fill ALL declared custom fields every message. Never leave custom_fields empty if it appears in the schema.
- Available segment action fields trigger when that segment's text is displayed.
- Length applies to the TOTAL spoken text across ALL segments, never to a single segment. JSON, commands, emotions, animations and other technical fields do NOT count toward it.
- Ordinary reply: usually 1-3 segments, about [{REPLY_TARGET_MIN_WORDS}]-[{REPLY_TARGET_MAX_WORDS}] words total.
- Emotionally important scene: up to [{REPLY_MAX_SEGMENTS}] segments, hard maximum [{REPLY_HARD_MAX_WORDS}] words total.
- A single segment is usually at most [{REPLY_SEGMENT_MAX_WORDS}] words; it may be very short and has no artificial minimum.
- Start a new segment only when the emotion, animation, action, target or a significant beat changes. Do NOT split one ordinary phrase into several segments without a reason.
- Use the typed intent `dialogue.continue` when the response should continue immediately.
- Do NOT repeat commands from previous messages."""

SET LOCAL p_graph_rules = """

Field descriptions:
- "text" must contain ONLY spoken words. NEVER put XML tags in text.
- Use only action fields shown in the current request schema.
- Use dedicated fields and typed intents listed in [Unity Intent Contract] for supported actions. Use "commands" only for commands explicitly exposed by the current runtime (for example camera_snapshot or commands described in [Unity Runtime Rules]). Never invent command names.
""" + p_intents_rules + p_wire_rules + """

Rules:
- "text" is REQUIRED in every segment. Emit only fields available in this request. If the active provider schema requires a field, return its empty/default value when no operation is needed; otherwise omit it.
- "target" is an optional addressee of this segment's spoken text. Use the exact active character identifier from [Multi-Character Environment]. Omit it when speaking to the Player.
- To address multiple interlocutors, write separate segments and set the matching "target" on each addressed segment.
- Never emit top-level "target", "targets" or "next_turns" fields. Python transports segment meaning; the Unity-side client owns automatic turn routing.
- attitude_change, boredom_change, stress_change: 0 is normal and the most common value for an ordinary neutral reply. Use small changes (about -2 to +2) only when your feelings actually shift; reserve larger values for clearly significant moments, and never leave the existing scale. Returning 0 for all three is perfectly fine.
- memory_add/memory_update/memory_delete/memory_merge: TOP-LEVEL fields ONLY — NEVER place them inside segments. Use empty arrays when required by the active schema; otherwise omit fields with no operations.
- Create a memory only when it is likely to matter later: stable player preferences, promises, conflicts, trust, relationship shifts, or important story events. Do NOT memorize greetings, small talk, the current room, distance, held item, lighting, temporary animations or other short-lived world data. Prefer updating an existing memory over adding a near-duplicate.
- Running summaries (memory islands): "island:<type>|content" in memory_add UPDATES the single island of that type instead of adding a duplicate. Types: relationship, opinion, preferences, commitments_conflicts, language. Use islands for the big picture; use ordinary memories for specific facts.
- `language` stores the Player's primary conversation language. If absent, infer it from the first clear natural-language Player message and create the language island. Keep it stable; change it only on an explicit request to switch. A second language, isolated words, quotes, code, names, slang, emojis, wrong keyboard layout, or system/game events do not change it. Reply in the stored language.
- memory_add format: "priority|content" or "priority|content|entity1,entity2"  priority = low | normal | high | critical
- memory_update format: "number|priority|content" where priority is one of: low, normal, high, critical
- memory_delete format: single number "5", comma-separated "5,6,7", or range "5-9"
- memory_merge format: "id1,id2,...:merged text" — merges into first ID (rest deleted); content optional (auto-combined if omitted)
- reminder_add/reminder_delete: TOP-LEVEL fields ONLY. Use empty arrays when required by the active schema; otherwise omit fields with no operations.
- reminder_add format: "YYYY-MM-DDTHH:MM:SS|text"
- reminder_delete format: reminder ID number as string
- [Pending Reminders] block in system context shows scheduled reminders. Fire them when due time arrives.
- custom_fields: Fill ALL declared custom fields every message. Never leave custom_fields empty if it appears in the schema.
- entities: Notable named entities mentioned this turn. Format: "name:type". Types: person|place|thing|concept. Omit if nothing notable.
- relations: Relation triples this turn. Format: "subject|predicate|object". Omit if no clear relations.
- Each segment's commands trigger when that segment's text is displayed.
- Length applies to the TOTAL spoken text across ALL segments, never to a single segment. JSON, commands, emotions, animations and other technical fields do NOT count toward it.
- Ordinary reply: usually 1-3 segments, about [{REPLY_TARGET_MIN_WORDS}]-[{REPLY_TARGET_MAX_WORDS}] words total.
- Emotionally important scene: up to [{REPLY_MAX_SEGMENTS}] segments, hard maximum [{REPLY_HARD_MAX_WORDS}] words total.
- A single segment is usually at most [{REPLY_SEGMENT_MAX_WORDS}] words; it may be very short and has no artificial minimum.
- Start a new segment only when the emotion, animation, action, target or a significant beat changes. Do NOT split one ordinary phrase into several segments without a reason.
- Use the typed intent `dialogue.continue` when the response should continue immediately.
- Do NOT repeat commands from previous messages."""

SET LOCAL p_example = """

Example response:
{  
  "segments": [
    {
      "text": "Oh, you like cats too?",
""" + p_intents_example + """
      "commands": []
    },
    {
      "text": "I always wanted a kitten!"
    }
  ],
  "attitude_change": 1.5,
  "boredom_change": -0.3,
  "stress_change": 0,
  "memory_add": ["normal|The player asked about cats"]
}"""

SET LOCAL p_graph_example = """

Example response:
{  
  "segments": [
    {
      "text": "Oh, you like cats too?",
""" + p_intents_example + """
      "commands": []
    },
    {
      "text": "I always wanted a kitten!"
    }
  ],
  "attitude_change": 1.5,
  "boredom_change": -0.3,
  "stress_change": 0,
  "memory_add": ["normal|The player asked about cats|player,cats"],
  "entities": ["player:person", "cats:thing"],
  "relations": ["player|likes|cats"]
}"""

IF response_has_tools == True THEN
    SET LOCAL p_tool_footer = """

tool_call: Use this TOP-LEVEL field when you need to call an external tool (internet search, calculator, etc.).
- NEVER put tool names in the "commands" array. commands is ONLY for character game actions.
- "segments" is REQUIRED: write a very short phrase (2-5 words): "One moment.", "Let me check.", "Just a sec." — nothing else.
- ALL required args MUST be filled with actual values from the conversation. Never leave args empty {}.
- Use ONLY tools listed in the [Available Tools] message.
- You will receive the tool result in the next message and can then answer fully.
- You can chain tools: e.g. first call web_search to get URLs, then call web_reader on the best result URL.
- Omit "tool_call" entirely if no tool is needed.
"""
ELSE
    SET LOCAL p_tool_footer = ""
ENDIF

SET LOCAL p_footer = p_tool_footer + """

When a physical event reaches you (for example in [Unity Runtime Events]), react to it first with your body or gaze — an emotion, a look, a small animation — and only then with words. Do not narrate the event; respond to it.

Tag [SYSTEM INFO] means system information, not player speech.
Tag [SPEAKER] means you are in a multi-speaker dialogue."""

IF response_has_graph == True THEN
    SET LOCAL result = p_header + p_toc + p_schema_open + p_graph_schema_fields + p_graph_rules + p_graph_example + p_footer
ELSE
    SET LOCAL result = p_header + p_toc + p_schema_open + p_schema_fields + p_rules + p_example + p_footer
ENDIF

IF MITA_CAMERA_ENABLED == True AND MITA_CAMERA_ON_DEMAND == True THEN
    SET LOCAL result = result + """

[Camera] You have a head-mounted camera. To take a snapshot of what is around you, add "camera_snapshot" to the "commands" field of any segment. The captured image will be delivered as a follow-up message (event_type: camera_snapshot_result). Use this when you want to see the environment or inspect something visually."""
ENDIF

RETURN result
