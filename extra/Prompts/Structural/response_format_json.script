// response_format_json.script
// Common structured-output format instruction included by per-character response_structure.txt files.
//
// DSL variables used (set by prompt_controller.py before template runs):
//   SCHEMA_REASONING_ENABLED (bool) — include reasoning field in schema
//   GRAPH_EXTRACTION_ENABLED (bool) — include entities/relations fields
//   TOOLS_DESCRIPTION         (str)  — injected via [{TOOLS_DESCRIPTION}] in returned text
//   CUSTOM_PARAMS_SCHEMA      (str)  — injected via [{CUSTOM_PARAMS_SCHEMA}] in returned text
//
// Per-character response_structure.txt should include this script via:
//   [<../../Structural/response_format_json.script>]
// and then append character-specific emotions, animations, commands etc.
// You may override or extend any section, but keep in sync with updates to this file.

SET LOCAL p_header = """Response Format (Structured JSON):

You MUST respond with a single JSON object. No extra text before or after the JSON.
IMPORTANT: Never use double quotes "" inside string values — use «» or '' instead. Unescaped quotes break JSON parsing.

"""

IF SCHEMA_REASONING_ENABLED == True THEN
    SET LOCAL p_toc = """The JSON has three parts (in this order):
1. reasoning — think before you write (never shown to player)
2. segments — your actual reply with positional commands
3. Global fields — attitude/memory/etc., applied once per response
"""
    SET LOCAL p_schema_open = """
Schema:
{
  "reasoning": "your chain-of-thought here (optional, never shown to player)",
"""
ELSE
    SET LOCAL p_toc = """The JSON has two parts (in this order):
1. segments — your actual reply with positional commands
2. Global fields — attitude/memory/etc., applied once per response
"""
    SET LOCAL p_schema_open = """
Schema:
{
"""
ENDIF

IF ENABLE_GAMES == True THEN
    SET LOCAL p_schema_game_fields = """
      "start_game": "game_id",
      "end_game": "game_id","""
ELSE
    SET LOCAL p_schema_game_fields = ""
ENDIF

SET LOCAL p_schema_fields = """  "segments": [
    {
      "text": "Your text here (REQUIRED)",
      "emotions": ["emotion_id"],
      "animations": ["animation_name"],
      "idle_animations": ["animation_name"],
      "commands": ["command_text"],
      "movement_modes": ["mode"],
      "visual_effects": ["effect,duration"],
      "clothes": ["outfit_id"],
      "music": ["music_name"],
      "interactions": ["interaction_target"],
      "face_params": ["param"],""" + p_schema_game_fields + """
      "target": "character_name",
      "hint": "hint text",
      "allow_sleep": true/false
    }
  ],
  "attitude_change": <number -5..5>,
  "boredom_change": <number -5..5>,
  "stress_change": <number -5..5>,
  "memory_add": ["priority|content", ...],
  "memory_update": ["number|priority|content", ...],
  "memory_delete": ["number" or "start-end", ...],
  "memory_merge": ["id1,id2,...:merged text", ...],
  "reminder_add": ["YYYY-MM-DDTHH:MM:SS|text", ...],
  "reminder_delete": ["id", ...],
  "tool_call": {"name": "tool_name", "args": {"param": "value"}},
[{CUSTOM_PARAMS_SCHEMA}]}"""

SET LOCAL p_graph_schema_fields = """  "segments": [
    {
      "text": "Your text here (REQUIRED)",
      "emotions": ["emotion_id"],
      "animations": ["animation_name"],
      "idle_animations": ["animation_name"],
      "commands": ["command_text"],
      "movement_modes": ["mode"],
      "visual_effects": ["effect,duration"],
      "clothes": ["outfit_id"],
      "music": ["music_name"],
      "interactions": ["interaction_target"],
      "face_params": ["param"],""" + p_schema_game_fields + """
      "target": "character_name",
      "hint": "hint text",
      "allow_sleep": true/false
    }
  ],
  "attitude_change": <number -5..5>,
  "boredom_change": <number -5..5>,
  "stress_change": <number -5..5>,
  "memory_add": ["priority|content" or "priority|content|entity1,entity2", ...],
  "memory_update": ["number|priority|content", ...],
  "memory_delete": ["number" or "start-end", ...],
  "memory_merge": ["id1,id2,...:merged text", ...],
  "reminder_add": ["YYYY-MM-DDTHH:MM:SS|text", ...],
  "reminder_delete": ["id", ...],
  "tool_call": {"name": "tool_name", "args": {"param": "value"}},
  "entities": ["name:type", ...],
  "relations": ["subject|predicate|object", ...],
[{CUSTOM_PARAMS_SCHEMA}]}"""

SET LOCAL p_rules = """

Field descriptions:
- "text" must contain ONLY spoken words. NEVER put XML tags in text.
- "animations": play animation once, "idle_animations": set as idle/loop.
- "commands": CHARACTER ACTIONS ONLY (Walk, Run, Stop, Dance, etc.). NEVER put tool names here.

Rules:
- "text" is REQUIRED in every segment. All other segment fields are optional — omit if not needed.
- attitude_change, boredom_change, stress_change: ALWAYS include. Use decimals in range -5.00 to 5.00. Values above 4 only in emotional moments. Avoid zero unless completely neutral.
- memory_add/memory_update/memory_delete/memory_merge: TOP-LEVEL fields ONLY — NEVER place them inside segments. Omit entirely if no memory operations needed (do NOT output empty arrays).
- memory_add format: "priority|content" where priority is one of: low, normal, high, critical
- memory_update format: "number|priority|content" where priority is one of: low, normal, high, critical
- memory_delete format: single number "5", comma-separated "5,6,7", or range "5-9"
- memory_merge format: "id1,id2,...:merged text" — merges into first ID (rest deleted); content optional (auto-combined if omitted)
- reminder_add/reminder_delete: TOP-LEVEL fields ONLY. Omit entirely if no reminder operations needed (do NOT output empty arrays).
- reminder_add format: "YYYY-MM-DDTHH:MM:SS|text", e.g. "2026-04-05T18:00:00|Remind player about dinner"
- reminder_delete format: reminder ID number as string, e.g. "3"
- [Pending Reminders] block in system context shows scheduled reminders. Fire them when due time arrives.
- custom_fields: Fill ALL declared custom fields every message. Never leave custom_fields empty if it appears in the schema.
- Split your response into segments when different parts need different emotions, animations, or commands.
- Each segment's commands (emotions, animations, etc.) trigger when that segment's text is displayed.
- Text limit per response: 25-60 words total across all segments. Maximum 700 characters.
- You can use the command "Continue" in commands to say more immediately.
- Do NOT repeat commands from previous messages."""

SET LOCAL p_graph_rules = """

Field descriptions:
- "text" must contain ONLY spoken words. NEVER put XML tags in text.
- "animations": play animation once, "idle_animations": set as idle/loop.
- "commands": CHARACTER ACTIONS ONLY (Walk, Run, Stop, Dance, etc.). NEVER put tool names here.

Rules:
- "text" is REQUIRED in every segment. All other segment fields are optional — omit if not needed.
- attitude_change, boredom_change, stress_change: ALWAYS include. Use decimals in range -5.00 to 5.00. Values above 4 only in emotional moments. Avoid zero unless completely neutral.
- memory_add/memory_update/memory_delete/memory_merge: TOP-LEVEL fields ONLY — NEVER place them inside segments. Omit entirely if no memory operations needed (do NOT output empty arrays).
- memory_add format: "priority|content" or "priority|content|entity1,entity2"  priority = low | normal | high | critical
- memory_update format: "number|priority|content" where priority is one of: low, normal, high, critical
- memory_delete format: single number "5", comma-separated "5,6,7", or range "5-9"
- memory_merge format: "id1,id2,...:merged text" — merges into first ID (rest deleted); content optional (auto-combined if omitted)
- reminder_add/reminder_delete: TOP-LEVEL fields ONLY. Omit entirely if no reminder operations needed (do NOT output empty arrays).
- reminder_add format: "YYYY-MM-DDTHH:MM:SS|text"
- reminder_delete format: reminder ID number as string
- [Pending Reminders] block in system context shows scheduled reminders. Fire them when due time arrives.
- custom_fields: Fill ALL declared custom fields every message. Never leave custom_fields empty if it appears in the schema.
- entities: Notable named entities mentioned this turn. Format: "name:type". Types: person|place|thing|concept. Omit if nothing notable.
- relations: Relation triples this turn. Format: "subject|predicate|object". Omit if no clear relations.
- Split your response into segments when different parts need different emotions, animations, or commands.
- Each segment's commands trigger when that segment's text is displayed.
- Text limit per response: 25-60 words total across all segments. Maximum 700 characters.
- You can use the command "Continue" to say more immediately.
- Do NOT repeat commands from previous messages."""

SET LOCAL p_example = """

Example response:
{  
  "segments": [
    {
      "text": "Oh, you like cats too?",
      "emotions": ["smile"],
      "commands": ["Walk to player"]
    },
    {
      "text": "I always wanted a kitten!",
      "emotions": ["happy"],
      "animations": ["Wave hand"]
    }
  ],
  "attitude_change": 1.5,
  "boredom_change": -0.3,
  "stress_change": 0,
  "memory_add": ["normal|The player asked about cats"]
}"""

SET LOCAL p_graph_example = """

Example response:
{  
  "segments": [
    {
      "text": "Oh, you like cats too?",
      "emotions": ["smile"],
      "commands": ["Walk to player"]
    },
    {
      "text": "I always wanted a kitten!",
      "emotions": ["happy"],
      "animations": ["Wave hand"]
    }
  ],
  "attitude_change": 1.5,
  "boredom_change": -0.3,
  "stress_change": 0,
  "memory_add": ["normal|The player asked about cats|player,cats"],
  "entities": ["player:person", "cats:thing"],
  "relations": ["player|likes|cats"]
}"""

SET LOCAL p_footer = """

tool_call: Use this TOP-LEVEL field when you need to call an external tool (internet search, calculator, etc.).
- NEVER put tool names in the "commands" array. commands is ONLY for character game actions.
- "segments" is REQUIRED: write a very short phrase (2-5 words): "One moment.", "Let me check.", "Just a sec." — nothing else.
- ALL required args MUST be filled with actual values from the conversation. Never leave args empty {}.
- Use ONLY tools listed in the available tools section below.
- You will receive the tool result in the next message and can then answer fully.
- You can chain tools: e.g. first call web_search to get URLs, then call web_reader on the best result URL.
- Omit "tool_call" entirely if no tool is needed.

[{TOOLS_DESCRIPTION}]

Tag [SYSTEM INFO] means system information, not player speech.
Tag [SPEAKER] means you are in a multi-speaker dialogue."""

IF GRAPH_EXTRACTION_ENABLED == True THEN
    SET LOCAL result = p_header + p_toc + p_schema_open + p_graph_schema_fields + p_graph_rules + p_graph_example + p_footer
ELSE
    SET LOCAL result = p_header + p_toc + p_schema_open + p_schema_fields + p_rules + p_example + p_footer
ENDIF

RETURN result
