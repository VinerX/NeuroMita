// Behavior band boundary overrides for the shared Structural/behavior_state.script.
// Cappie: attitude guarded 0-40 / curious 41-79 / bonded 80+ (flirt unlocks at 80,
// deep truth at 95+ described inside RelationHigh); boredom low 0-30; stress calm 0-30.
SET BEH_ATT_LOW_MAX = 40
SET BEH_ATT_HIGH_MIN = 79
SET BEH_BOR_LOW_MAX = 30
SET BEH_BOR_HIGH_MIN = 70
SET BEH_STR_LOW_MAX = 30
SET BEH_STR_HIGH_MIN = 70

// Общая эрудиция о мире + персональные стартовые память/остров (план 09).
RUN ../../../Common/world_knowledge.script
IF SEED_CHARACTER_MEMORIES != False THEN
	RUN ./character_seed.script
ENDIF
